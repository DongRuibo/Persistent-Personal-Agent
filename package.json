{
  "name": "personal-agent-v0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "web:watch": "vite build --watch --config web/vite.config.ts",
    "web:start": "node dist/main.js --web-ui",
    "web:dev": "node --import tsx src/main.ts --web-ui",
    "web:preview:offline": "node --import tsx scripts/preview-web-ui.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:memory": "node --import tsx scripts/evaluate-memory.ts",
    "eval:formation": "node --import tsx scripts/evaluate-formation.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "lucide-react": "1.62.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
