# Copy this file to .env and configure it locally. Never commit real keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=<REDACTED>
# Optional: OpenAI-compatible /v1 endpoint. Requires LLM_MODEL.
# LLM_BASE_URL=https://api.example.com/v1
USER_TIMEZONE=Asia/Taipei
DATABASE_PATH=./data/agent.db
# Optional: defaults to <DATABASE_PATH>.sessions; keep one directory per database.
# SESSION_DIR=./data/sessions
# Optional: dedicated Memory directory; defaults to <DATABASE_PATH>.memory.
# MEMORY_DIR=./data/memory
# MEMORY_CONTEXT_TOKENS=2048
# Optional: one query-only rewrite on low confidence, using the configured model.
# Default false (no extra API cost); true adds at most one 512-output-token request/run.
# MEMORY_QUERY_REWRITE=false
# 候选形成默认关闭；开启只处理之后成功的新聊天，未经逐条批准不会写 Memory。
# MEMORY_FORMATION_ENABLED=false
# 开启前填入当前供应商每百万 Token 人民币费率的保守上界；不是账单硬限制。
# MEMORY_FORMATION_INPUT_CNY_PER_MILLION=10
# MEMORY_FORMATION_OUTPUT_CNY_PER_MILLION=20
POLL_INTERVAL_MS=1000
EXECUTION_TIMEOUT_MS=120000
# Optional: Feishu enterprise self-built bot. Enable with npm start -- --feishu.
# FEISHU_APP_ID=cli_0123456789abcdef
# FEISHU_APP_SECRET=<REDACTED>
# FEISHU_ALLOWED_OPEN_ID=ou_your_open_id
# 长期Goal默认关闭，隔离验收进程显式开启；不要与Formation开关混淆。
# GOAL_ENABLED=false
# 主动执行另有总开关；仅开启Goal不启用策略或Observer。不要在正式环境默认开启。
# PROACTIVE_ENABLED=false
# 开启前核对供应商每百万Token人民币费率上界；0或未知费率会阻塞自动执行。
# PROACTIVE_INPUT_CNY_PER_MILLION=0
# PROACTIVE_OUTPUT_CNY_PER_MILLION=0
# 每日按UTC计数；总额跨重启/策略保留，不因调用失败退还预留。
# PROACTIVE_DAILY_CALLS=20
# PROACTIVE_DAILY_EXECUTIONS=20
# PROACTIVE_DAILY_BUDGET_CNY=1
# PROACTIVE_TOTAL_EXECUTIONS=100
# PROACTIVE_TOTAL_BUDGET_CNY=5
